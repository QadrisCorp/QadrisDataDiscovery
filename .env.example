# QadrisDataDiscovery 環境變數設定
# 複製此檔為 .env 並依需求修改

# --- 專案路徑 ---
# RSR_PROJECT_ROOT=.  # 預設為當前工作目錄

# --- Base URLs ---
# RSR_TWSE_OPENAPI_BASE=https://openapi.twse.com.tw/v1
# RSR_TWSE_WEB_BASE=https://www.twse.com.tw
# RSR_TPEX_OPENAPI_BASE=https://www.tpex.org.tw/openapi/v1
# RSR_TPEX_WEB_BASE=https://www.tpex.org.tw
# RSR_MOPS_BASE=https://mops.twse.com.tw

# --- 請求設定 ---
# RSR_REQUEST_TIMEOUT=30        # HTTP 請求逾時 (秒)
# RSR_OPENAPI_DELAY=1.0         # OpenAPI 請求間隔 (秒)
# RSR_WEB_DELAY=3.0             # Web 請求間隔 (秒)
# RSR_MAX_SAMPLE_RECORDS=5      # 每個 endpoint 儲存的樣本筆數上限
