# QadrisDataDiscovery 環境變數設定
# 複製此檔為 .env 並依需求修改

# --- 專案路徑 ---
# RSR_PROJECT_ROOT=.  # 預設為當前工作目錄

# --- Base URLs（台灣）---
# RSR_TWSE_OPENAPI_BASE=https://openapi.twse.com.tw/v1
# RSR_TWSE_WEB_BASE=https://www.twse.com.tw
# RSR_TPEX_OPENAPI_BASE=https://www.tpex.org.tw/openapi/v1
# RSR_TPEX_WEB_BASE=https://www.tpex.org.tw
# RSR_MOPS_BASE=https://mops.twse.com.tw
# RSR_TDCC_OPENAPI_BASE=https://openapi.tdcc.com.tw

# --- Base URLs（日本）---
# RSR_JQUANTS_BASE=https://api.jquants.com/v2
# RSR_EDINET_BASE=https://api.edinet-fsa.go.jp/api/v2
# RSR_TDNET_BASE=https://www.release.tdnet.info
# RSR_JPX_BASE=https://www.jpx.co.jp

# --- API 金鑰（日本源）---
# J-Quants：註冊 https://jpx-jquants.com/ 後取得（V2 以 x-api-key header 認證）
# RSR_JQUANTS_API_KEY=
# EDINET：註冊 EDINET API（免費、含多要素認證）後取得 Subscription-Key
# RSR_EDINET_API_KEY=

# --- 請求設定 ---
# RSR_REQUEST_TIMEOUT=30        # HTTP 請求逾時 (秒)
# RSR_OPENAPI_DELAY=1.0         # OpenAPI 請求間隔 (秒)
# RSR_WEB_DELAY=3.0             # Web 請求間隔 (秒)
# RSR_MAX_SAMPLE_RECORDS=5      # 每個 endpoint 儲存的樣本筆數上限
